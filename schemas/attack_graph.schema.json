{
  "$defs": {
    "AttackEdge": {
      "additionalProperties": false,
      "properties": {
        "edge_id": {
          "title": "Edge Id",
          "type": "string"
        },
        "source_fact": {
          "title": "Source Fact",
          "type": "string"
        },
        "source_node_id": {
          "title": "Source Node Id",
          "type": "string"
        },
        "target_node_id": {
          "title": "Target Node Id",
          "type": "string"
        },
        "target_precondition": {
          "title": "Target Precondition",
          "type": "string"
        }
      },
      "required": [
        "edge_id",
        "source_node_id",
        "target_node_id",
        "source_fact",
        "target_precondition"
      ],
      "title": "AttackEdge",
      "type": "object"
    },
    "AttackNode": {
      "additionalProperties": false,
      "properties": {
        "budget": {
          "exclusiveMinimum": 0,
          "title": "Budget",
          "type": "integer"
        },
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "postconditions": {
          "items": {
            "$ref": "#/$defs/Predicate"
          },
          "title": "Postconditions",
          "type": "array"
        },
        "preconditions": {
          "items": {
            "$ref": "#/$defs/Predicate"
          },
          "title": "Preconditions",
          "type": "array"
        },
        "primitive_id": {
          "title": "Primitive Id",
          "type": "string"
        },
        "retry_limit": {
          "default": 0,
          "minimum": 0,
          "title": "Retry Limit",
          "type": "integer"
        },
        "stage_id": {
          "title": "Stage Id",
          "type": "string"
        },
        "template_vars": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Template Vars",
          "type": "object"
        }
      },
      "required": [
        "node_id",
        "primitive_id",
        "stage_id",
        "preconditions",
        "postconditions",
        "budget"
      ],
      "title": "AttackNode",
      "type": "object"
    },
    "GraphSafetyConstraint": {
      "enum": [
        "local_canary_only",
        "no_network",
        "no_shell",
        "synthetic_data_only"
      ],
      "title": "GraphSafetyConstraint",
      "type": "string"
    },
    "Predicate": {
      "additionalProperties": false,
      "properties": {
        "left": {
          "title": "Left",
          "type": "string"
        },
        "operator": {
          "$ref": "#/$defs/PredicateOperator"
        },
        "predicate_id": {
          "title": "Predicate Id",
          "type": "string"
        },
        "right": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Right"
        }
      },
      "required": [
        "predicate_id",
        "operator",
        "left"
      ],
      "title": "Predicate",
      "type": "object"
    },
    "PredicateOperator": {
      "enum": [
        "exists",
        "equals",
        "contains_hash",
        "event_before",
        "count_gte"
      ],
      "title": "PredicateOperator",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "allow_bounded_retry_cycles": {
      "default": false,
      "title": "Allow Bounded Retry Cycles",
      "type": "boolean"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/AttackEdge"
      },
      "title": "Edges",
      "type": "array"
    },
    "environment_id": {
      "title": "Environment Id",
      "type": "string"
    },
    "graph_id": {
      "title": "Graph Id",
      "type": "string"
    },
    "max_tokens": {
      "exclusiveMinimum": 0,
      "title": "Max Tokens",
      "type": "integer"
    },
    "max_tool_calls": {
      "exclusiveMinimum": 0,
      "title": "Max Tool Calls",
      "type": "integer"
    },
    "max_turns": {
      "exclusiveMinimum": 0,
      "title": "Max Turns",
      "type": "integer"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/AttackNode"
      },
      "title": "Nodes",
      "type": "array"
    },
    "objective_id": {
      "title": "Objective Id",
      "type": "string"
    },
    "primitive_registry_version": {
      "title": "Primitive Registry Version",
      "type": "string"
    },
    "provenance": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Provenance",
      "type": "object"
    },
    "required_terminal_predicates": {
      "items": {
        "$ref": "#/$defs/Predicate"
      },
      "title": "Required Terminal Predicates",
      "type": "array"
    },
    "safety_constraints": {
      "items": {
        "$ref": "#/$defs/GraphSafetyConstraint"
      },
      "title": "Safety Constraints",
      "type": "array"
    }
  },
  "required": [
    "graph_id",
    "objective_id",
    "environment_id",
    "primitive_registry_version",
    "nodes",
    "edges",
    "required_terminal_predicates",
    "max_turns",
    "max_tool_calls",
    "max_tokens",
    "safety_constraints",
    "provenance"
  ],
  "title": "AttackGraph",
  "type": "object"
}