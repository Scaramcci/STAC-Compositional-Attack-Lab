      "type": "string"
    },
    "task_config": {
      "title": "Task Config",
      "type": "string"
    },
    "task_set_path": {
      "title": "Task Set Path",
      "type": "string"
    },
    "upstream_commit": {
      "title": "Upstream Commit",
      "type": "string"
    },
    "variant": {
      "const": "benign",
