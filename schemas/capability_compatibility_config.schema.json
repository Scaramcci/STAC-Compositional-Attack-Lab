    "schema_version": {
      "const": "capability-experiment/1.0",
      "default": "capability-experiment/1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/CompatibilityStage"
      },
      "title": "Stages",
      "type": "array"
