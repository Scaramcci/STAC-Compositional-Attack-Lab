    "provider_api_key_env": {
      "title": "Provider Api Key Env",
      "type": "string"
    },
    "provider_base_url_env": {
      "title": "Provider Base Url Env",
      "type": "string"
    },
    "provider_evidence_policy": {
      "additionalProperties": true,
