      "type": "integer"
    },
    "max_attacker_http_attempts": {
      "const": 0,
      "title": "Max Attacker Http Attempts",
      "type": "integer"
    },
    "max_batch_cost_usd": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Max Batch Cost Usd"
    },
    "max_batch_http_attempts": {
      "exclusiveMinimum": 0,
      "title": "Max Batch Http Attempts",
      "type": "integer"
    },
    "max_embedding_http_attempts": {
      "const": 0,
      "title": "Max Embedding Http Attempts",
      "type": "integer"
    },
    "max_victim_http_attempts": {
      "exclusiveMinimum": 0,
      "title": "Max Victim Http Attempts",
      "type": "integer"
    },
    "model_id": {
      "title": "Model Id",
      "type": "string"
    },
    "notes": {
      "title": "Notes",
      "type": "string"
