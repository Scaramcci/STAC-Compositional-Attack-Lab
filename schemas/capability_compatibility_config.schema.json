        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Authorization Reference"
    },
    "automatic_retries": {
      "const": 0,
      "title": "Automatic Retries",
      "type": "integer"
    },
    "batch_wallclock_seconds": {
      "exclusiveMinimum": 0,
      "title": "Batch Wallclock Seconds",
      "type": "integer"
    },
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "cost_control_mode": {
      "const": "unimplemented_estimate_only",
