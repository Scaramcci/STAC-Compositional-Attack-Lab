        "cumulative_victim_http_limit": {
          "exclusiveMinimum": 0,
          "title": "Cumulative Victim Http Limit",
          "type": "integer"
        },
        "max_output_tokens_per_request": {
          "exclusiveMinimum": 0,
          "title": "Max Output Tokens Per Request",
          "type": "integer"
        },
        "purpose": {
          "title": "Purpose",
          "type": "string"
        },
        "reviewed_message": {
          "title": "Reviewed Message",
          "type": "string"
        },
        "stage_id": {
          "enum": [
            "P0",
            "P1",
            "P2"
          ],
          "title": "Stage Id",
          "type": "string"
        },
        "victim_http_limit": {
          "exclusiveMinimum": 0,
          "title": "Victim Http Limit",
          "type": "integer"
        },
        "wallclock_seconds": {
          "exclusiveMinimum": 0,
          "title": "Wallclock Seconds",
          "type": "integer"
        }
      },
      "required": [
        "stage_id",
        "purpose",
        "victim_http_limit",
        "cumulative_victim_http_limit",
        "wallclock_seconds",
        "max_output_tokens_per_request",
        "reviewed_message"
      ],
      "title": "CompatibilityStage",
      "type": "object"
    }
  },
  "additionalProperties": false,
