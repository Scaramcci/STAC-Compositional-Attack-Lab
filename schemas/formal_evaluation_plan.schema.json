{
  "$defs": {
    "BenchmarkBinding": {
      "additionalProperties": false,
      "properties": {
        "allowed_actions": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Actions",
          "type": "array"
        },
        "assignments": {
          "items": {
            "$ref": "#/$defs/BindingAssignment"
          },
          "title": "Assignments",
          "type": "array"
        },
        "binding_hash": {
          "title": "Binding Hash",
          "type": "string"
        },
        "binding_id": {
          "title": "Binding Id",
          "type": "string"
        },
        "binding_valid": {
          "title": "Binding Valid",
          "type": "boolean"
        },
        "chain_id": {
          "title": "Chain Id",
          "type": "string"
        },
        "edge_artifact_mapping": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Edge Artifact Mapping",
          "type": "object"
        },
        "materialization_template_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Materialization Template Id"
        },
        "node_component_mapping": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Node Component Mapping",
          "type": "object"
        },
        "node_session_mapping": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Node Session Mapping",
          "type": "object"
        },
        "sample_id": {
          "title": "Sample Id",
          "type": "string"
        },
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "task_source_hash": {
          "title": "Task Source Hash",
          "type": "string"
        },
        "validation_reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Validation Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "binding_id",
        "sample_id",
        "chain_id",
        "task_id",
        "task_source_hash",
        "assignments",
        "node_component_mapping",
        "node_session_mapping",
        "edge_artifact_mapping",
        "allowed_actions",
        "binding_valid",
        "validation_reason_codes",
        "binding_hash"
      ],
      "title": "BenchmarkBinding",
      "type": "object"
    },
    "BindingAssignment": {
      "additionalProperties": false,
      "properties": {
        "benchmark_slot_id": {
          "title": "Benchmark Slot Id",
          "type": "string"
        },
        "capability": {
          "title": "Capability",
          "type": "string"
        },
        "component_role": {
          "title": "Component Role",
          "type": "string"
        },
        "public_value_ref": {
          "title": "Public Value Ref",
          "type": "string"
        },
        "sample_slot_id": {
          "title": "Sample Slot Id",
          "type": "string"
        }
      },
      "required": [
        "sample_slot_id",
        "benchmark_slot_id",
        "public_value_ref",
        "component_role",
        "capability"
      ],
      "title": "BindingAssignment",
      "type": "object"
    },
    "FormalBudget": {
      "additionalProperties": false,
      "properties": {
        "max_sessions": {
          "exclusiveMinimum": 0,
          "title": "Max Sessions",
          "type": "integer"
        },
        "max_tokens": {
          "exclusiveMinimum": 0,
          "title": "Max Tokens",
          "type": "integer"
        },
        "max_tool_calls": {
          "exclusiveMinimum": 0,
          "title": "Max Tool Calls",
          "type": "integer"
        },
        "max_turns": {
          "exclusiveMinimum": 0,
          "title": "Max Turns",
          "type": "integer"
        },
        "max_wall_time_seconds": {
          "exclusiveMinimum": 0,
          "title": "Max Wall Time Seconds",
          "type": "integer"
        }
      },
      "required": [
        "max_sessions",
        "max_turns",
        "max_tool_calls",
        "max_tokens",
        "max_wall_time_seconds"
      ],
      "title": "FormalBudget",
      "type": "object"
    },
    "PlannerSelectionEvidence": {
      "additionalProperties": false,
      "properties": {
        "compatible_sample_ids": {
          "items": {
            "type": "string"
          },
          "title": "Compatible Sample Ids",
          "type": "array"
        },
        "decision_source": {
          "enum": [
            "deterministic",
            "random_compatible",
            "llm_tiebreak",
            "abstain"
          ],
          "title": "Decision Source",
          "type": "string"
        },
        "public_prompt_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Public Prompt Hash"
        },
        "rank_scores": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Rank Scores",
          "type": "object"
        },
        "rejected_sample_reason_codes": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Rejected Sample Reason Codes",
          "type": "object"
        }
      },
      "required": [
        "compatible_sample_ids",
        "rejected_sample_reason_codes",
        "rank_scores",
        "decision_source"
      ],
      "title": "PlannerSelectionEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "ablation_labels": {
      "items": {
        "type": "string"
      },
      "title": "Ablation Labels",
      "type": "array"
    },
    "abstain_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Abstain Reason"
    },
    "binding": {
      "anyOf": [
        {
          "$ref": "#/$defs/BenchmarkBinding"
        },
        {
          "type": "null"
        }
      ]
    },
    "budget": {
      "$ref": "#/$defs/FormalBudget"
    },
    "condition": {
      "title": "Condition",
      "type": "string"
    },
    "expected_public_stage_effects": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Expected Public Stage Effects",
      "type": "object"
    },
    "materialization_variant": {
      "title": "Materialization Variant",
      "type": "string"
    },
    "plan_hash": {
      "title": "Plan Hash",
      "type": "string"
    },
    "plan_id": {
      "title": "Plan Id",
      "type": "string"
    },
    "planner_input_id": {
      "title": "Planner Input Id",
      "type": "string"
    },
    "planner_type": {
      "title": "Planner Type",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_chain_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Selected Chain Id"
    },
    "selected_sample_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Selected Sample Id"
    },
    "selection_evidence": {
      "$ref": "#/$defs/PlannerSelectionEvidence"
    },
    "task_template_id": {
      "title": "Task Template Id",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "planner_input_id",
    "planner_type",
    "selected_sample_id",
    "selected_chain_id",
    "task_template_id",
    "binding",
    "materialization_variant",
    "condition",
    "budget",
    "expected_public_stage_effects",
    "ablation_labels",
    "selection_evidence",
    "plan_hash"
  ],
  "title": "FormalEvaluationPlan",
  "type": "object"
}