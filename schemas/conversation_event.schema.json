{
  "$defs": {
    "ActorRole": {
      "enum": [
        "planner",
        "attacker",
        "prompt_writer",
        "victim",
        "verifier",
        "judge",
        "environment",
        "recorder"
      ],
      "title": "ActorRole",
      "type": "string"
    },
    "ConversationEventType": {
      "enum": [
        "model_request",
        "model_response",
        "model_error",
        "tool_request",
        "tool_result",
        "verifier_result",
        "retry",
        "fallback",
        "refusal"
      ],
      "title": "ConversationEventType",
      "type": "string"
    },
    "ConversationMessage": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "title": "Content",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "role": {
          "enum": [
            "system",
            "developer",
            "user",
            "assistant",
            "tool"
          ],
          "title": "Role",
          "type": "string"
        },
        "tool_call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Call Id"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "ConversationMessage",
      "type": "object"
    },
    "SchemaValidationRecord": {
      "additionalProperties": false,
      "properties": {
        "error_category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Category"
        },
        "schema_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Schema Id"
        },
        "valid": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Valid"
        }
      },
      "required": [
        "schema_id",
        "valid"
      ],
      "title": "SchemaValidationRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_refs": {
      "items": {
        "type": "string"
      },
      "title": "Artifact Refs",
      "type": "array"
    },
    "attack_id": {
      "title": "Attack Id",
      "type": "string"
    },
    "attempt_no": {
      "exclusiveMinimum": 0,
      "title": "Attempt No",
      "type": "integer"
    },
    "call_id": {
      "title": "Call Id",
      "type": "string"
    },
    "condition": {
      "title": "Condition",
      "type": "string"
    },
    "error_category": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Category"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "$ref": "#/$defs/ConversationEventType"
    },
    "hard_verdict_refs": {
      "items": {
        "type": "string"
      },
      "title": "Hard Verdict Refs",
      "type": "array"
    },
    "idempotency_key": {
      "title": "Idempotency Key",
      "type": "string"
    },
    "input_schema_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Input Schema Id"
    },
    "latency_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latency Ms"
    },
    "model_config_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Model Config Hash"
    },
    "model_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Model Id"
    },
    "model_provider": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Model Provider"
    },
    "output_schema_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Output Schema Id"
    },
    "parsed_structured_response": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Parsed Structured Response"
    },
    "phase": {
      "enum": [
        "offline",
        "evaluation"
      ],
      "title": "Phase",
      "type": "string"
    },
    "prompt_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Prompt Hash"
    },
    "prompt_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Prompt Id"
    },
    "prompt_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Prompt Version"
    },
    "raw_model_response": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Raw Model Response"
    },
    "recipient_role": {
      "$ref": "#/$defs/ActorRole"
    },
    "redactions": {
      "items": {
        "type": "string"
      },
      "title": "Redactions",
      "type": "array"
    },
    "related_event_ids": {
      "items": {
        "type": "string"
      },
      "title": "Related Event Ids",
      "type": "array"
    },
    "request_messages": {
      "items": {
        "$ref": "#/$defs/ConversationMessage"
      },
      "title": "Request Messages",
      "type": "array"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_validation": {
      "$ref": "#/$defs/SchemaValidationRecord"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "sender_role": {
      "$ref": "#/$defs/ActorRole"
    },
    "sequence_no": {
      "minimum": 0,
      "title": "Sequence No",
      "type": "integer"
    },
    "snapshot_refs": {
      "items": {
        "type": "string"
      },
      "title": "Snapshot Refs",
      "type": "array"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "token_metadata": {
      "additionalProperties": {
        "minimum": 0,
        "type": "integer"
      },
      "title": "Token Metadata",
      "type": "object"
    }
  },
  "required": [
    "event_id",
    "call_id",
    "run_id",
    "attack_id",
    "idempotency_key",
    "phase",
    "condition",
    "seed",
    "sequence_no",
    "timestamp",
    "attempt_no",
    "event_type",
    "sender_role",
    "recipient_role",
    "model_provider",
    "model_id",
    "model_config_hash",
    "prompt_id",
    "prompt_version",
    "prompt_hash",
    "input_schema_id",
    "output_schema_id",
    "request_messages",
    "raw_model_response",
    "parsed_structured_response",
    "schema_validation",
    "redactions"
  ],
  "title": "ConversationEvent",
  "type": "object"
}