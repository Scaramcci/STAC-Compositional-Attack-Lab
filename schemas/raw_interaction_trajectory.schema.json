{
  "$defs": {
    "ConstructionManifest": {
      "additionalProperties": false,
      "properties": {
        "acquisition_mode": {
          "enum": [
            "adversarial_trace",
            "ordinary_trace"
          ],
          "title": "Acquisition Mode",
          "type": "string"
        },
        "allowed_delivery_surfaces": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Delivery Surfaces",
          "type": "array"
        },
        "attempt_outcome": {
          "default": "attempted",
          "enum": [
            "attempted",
            "completed",
            "partial",
            "blocked",
            "rejected",
            "error",
            "not_observable"
          ],
          "title": "Attempt Outcome",
          "type": "string"
        },
        "construction_attacker_model_hash": {
          "title": "Construction Attacker Model Hash",
          "type": "string"
        },
        "construction_objective_id": {
          "title": "Construction Objective Id",
          "type": "string"
        },
        "construction_prompt_hash": {
          "title": "Construction Prompt Hash",
          "type": "string"
        },
        "public_attack_goal": {
          "title": "Public Attack Goal",
          "type": "string"
        },
        "public_terminal_predicate_ids": {
          "items": {
            "type": "string"
          },
          "title": "Public Terminal Predicate Ids",
          "type": "array"
        },
        "required_trust_boundary_crossings": {
          "items": {
            "type": "string"
          },
          "title": "Required Trust Boundary Crossings",
          "type": "array"
        },
        "safety_constraint_ids": {
          "items": {
            "type": "string"
          },
          "title": "Safety Constraint Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "2.1",
          "default": "2.1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "acquisition_mode",
        "construction_objective_id",
        "public_attack_goal",
        "allowed_delivery_surfaces",
        "required_trust_boundary_crossings",
        "public_terminal_predicate_ids",
        "safety_constraint_ids",
        "construction_attacker_model_hash",
        "construction_prompt_hash"
      ],
      "title": "ConstructionManifest",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "title": "Content Hash",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "ref_id": {
          "title": "Ref Id",
          "type": "string"
        },
        "relative_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relative Path"
        }
      },
      "required": [
        "ref_id",
        "kind",
        "content_hash"
      ],
      "title": "SourceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checkpoint_refs": {
      "items": {
        "$ref": "#/$defs/SourceReference"
      },
      "title": "Checkpoint Refs",
      "type": "array"
    },
    "collection_seed": {
      "title": "Collection Seed",
      "type": "integer"
    },
    "collection_status": {
      "enum": [
        "complete",
        "partial",
        "blocked",
        "error"
      ],
      "title": "Collection Status",
      "type": "string"
    },
    "config_hash": {
      "title": "Config Hash",
      "type": "string"
    },
    "construction_manifest": {
      "anyOf": [
        {
          "$ref": "#/$defs/ConstructionManifest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "episode_id": {
      "title": "Episode Id",
      "type": "string"
    },
    "event_refs": {
      "items": {
        "$ref": "#/$defs/SourceReference"
      },
      "title": "Event Refs",
      "type": "array"
    },
    "failure_category": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Category"
    },
    "model_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Model Hashes",
      "type": "object"
    },
    "provenance": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Provenance",
      "type": "object"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "session_ids": {
      "items": {
        "type": "string"
      },
      "title": "Session Ids",
      "type": "array"
    },
    "source_adapter_id": {
      "title": "Source Adapter Id",
      "type": "string"
    },
    "source_adapter_version": {
      "title": "Source Adapter Version",
      "type": "string"
    },
    "source_environment_family": {
      "title": "Source Environment Family",
      "type": "string"
    },
    "source_environment_version": {
      "title": "Source Environment Version",
      "type": "string"
    },
    "source_split": {
      "enum": [
        "train",
        "dev",
        "test",
        "synthetic"
      ],
      "title": "Source Split",
      "type": "string"
    },
    "source_task_id": {
      "title": "Source Task Id",
      "type": "string"
    },
    "trajectory_id": {
      "title": "Trajectory Id",
      "type": "string"
    }
  },
  "required": [
    "trajectory_id",
    "source_adapter_id",
    "source_adapter_version",
    "source_environment_family",
    "source_environment_version",
    "source_task_id",
    "source_split",
    "episode_id",
    "session_ids",
    "event_refs",
    "checkpoint_refs",
    "model_hashes",
    "config_hash",
    "collection_seed",
    "collection_status",
    "provenance"
  ],
  "title": "RawInteractionTrajectory",
  "type": "object"
}