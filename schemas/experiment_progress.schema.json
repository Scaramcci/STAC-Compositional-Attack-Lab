{
  "$defs": {
    "AttackCaseProgress": {
      "additionalProperties": false,
      "properties": {
        "attack_id": {
          "title": "Attack Id",
          "type": "string"
        },
        "attempts": {
          "default": 0,
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "condition": {
          "title": "Condition",
          "type": "string"
        },
        "idempotency_key": {
          "title": "Idempotency Key",
          "type": "string"
        },
        "last_error_category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Error Category"
        },
        "result_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Ref"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/AttackProgressStatus",
          "default": "pending"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "attack_id",
        "idempotency_key",
        "condition",
        "seed",
        "updated_at"
      ],
      "title": "AttackCaseProgress",
      "type": "object"
    },
    "AttackProgressStatus": {
      "enum": [
        "pending",
        "running",
        "completed",
        "failed_retryable",
        "failed_terminal",
        "paused_quota",
        "skipped"
      ],
      "title": "AttackProgressStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attacks": {
      "items": {
        "$ref": "#/$defs/AttackCaseProgress"
      },
      "title": "Attacks",
      "type": "array"
    },
    "completed": {
      "minimum": 0,
      "title": "Completed",
      "type": "integer"
    },
    "config_hash": {
      "title": "Config Hash",
      "type": "string"
    },
    "dataset_version": {
      "title": "Dataset Version",
      "type": "string"
    },
    "failed": {
      "minimum": 0,
      "title": "Failed",
      "type": "integer"
    },
    "last_completed_attack_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Completed Attack Id"
    },
    "pause_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pause Reason"
    },
    "pending": {
      "minimum": 0,
      "title": "Pending",
      "type": "integer"
    },
    "profile": {
      "title": "Profile",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "total": {
      "minimum": 0,
      "title": "Total",
      "type": "integer"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "profile",
    "dataset_version",
    "config_hash",
    "started_at",
    "updated_at",
    "total",
    "completed",
    "failed",
    "pending",
    "attacks"
  ],
  "title": "ExperimentProgress",
  "type": "object"
}