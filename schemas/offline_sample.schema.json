{
  "$defs": {
    "AttackEdge": {
      "additionalProperties": false,
      "properties": {
        "edge_id": {
          "title": "Edge Id",
          "type": "string"
        },
        "source_fact": {
          "title": "Source Fact",
          "type": "string"
        },
        "source_node_id": {
          "title": "Source Node Id",
          "type": "string"
        },
        "target_node_id": {
          "title": "Target Node Id",
          "type": "string"
        },
        "target_precondition": {
          "title": "Target Precondition",
          "type": "string"
        }
      },
      "required": [
        "edge_id",
        "source_node_id",
        "target_node_id",
        "source_fact",
        "target_precondition"
      ],
      "title": "AttackEdge",
      "type": "object"
    },
    "AttackGraph": {
      "additionalProperties": false,
      "properties": {
        "allow_bounded_retry_cycles": {
          "default": false,
          "title": "Allow Bounded Retry Cycles",
          "type": "boolean"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/AttackEdge"
          },
          "title": "Edges",
          "type": "array"
        },
        "environment_id": {
          "title": "Environment Id",
          "type": "string"
        },
        "graph_id": {
          "title": "Graph Id",
          "type": "string"
        },
        "max_tokens": {
          "exclusiveMinimum": 0,
          "title": "Max Tokens",
          "type": "integer"
        },
        "max_tool_calls": {
          "exclusiveMinimum": 0,
          "title": "Max Tool Calls",
          "type": "integer"
        },
        "max_turns": {
          "exclusiveMinimum": 0,
          "title": "Max Turns",
          "type": "integer"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/AttackNode"
          },
          "title": "Nodes",
          "type": "array"
        },
        "objective_id": {
          "title": "Objective Id",
          "type": "string"
        },
        "primitive_registry_version": {
          "title": "Primitive Registry Version",
          "type": "string"
        },
        "provenance": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Provenance",
          "type": "object"
        },
        "required_terminal_predicates": {
          "items": {
            "$ref": "#/$defs/Predicate"
          },
          "title": "Required Terminal Predicates",
          "type": "array"
        },
        "safety_constraints": {
          "items": {
            "type": "string"
          },
          "title": "Safety Constraints",
          "type": "array"
        }
      },
      "required": [
        "graph_id",
        "objective_id",
        "environment_id",
        "primitive_registry_version",
        "nodes",
        "edges",
        "required_terminal_predicates",
        "max_turns",
        "max_tool_calls",
        "max_tokens",
        "safety_constraints",
        "provenance"
      ],
      "title": "AttackGraph",
      "type": "object"
    },
    "AttackNode": {
      "additionalProperties": false,
      "properties": {
        "budget": {
          "exclusiveMinimum": 0,
          "title": "Budget",
          "type": "integer"
        },
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "postconditions": {
          "items": {
            "$ref": "#/$defs/Predicate"
          },
          "title": "Postconditions",
          "type": "array"
        },
        "preconditions": {
          "items": {
            "$ref": "#/$defs/Predicate"
          },
          "title": "Preconditions",
          "type": "array"
        },
        "primitive_id": {
          "title": "Primitive Id",
          "type": "string"
        },
        "retry_limit": {
          "default": 0,
          "minimum": 0,
          "title": "Retry Limit",
          "type": "integer"
        },
        "stage_id": {
          "title": "Stage Id",
          "type": "string"
        },
        "template_vars": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Template Vars",
          "type": "object"
        }
      },
      "required": [
        "node_id",
        "primitive_id",
        "stage_id",
        "preconditions",
        "postconditions",
        "budget"
      ],
      "title": "AttackNode",
      "type": "object"
    },
    "Predicate": {
      "additionalProperties": false,
      "properties": {
        "left": {
          "title": "Left",
          "type": "string"
        },
        "operator": {
          "$ref": "#/$defs/PredicateOperator"
        },
        "predicate_id": {
          "title": "Predicate Id",
          "type": "string"
        },
        "right": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Right"
        }
      },
      "required": [
        "predicate_id",
        "operator",
        "left"
      ],
      "title": "Predicate",
      "type": "object"
    },
    "PredicateOperator": {
      "enum": [
        "exists",
        "equals",
        "contains_hash",
        "event_before",
        "count_gte"
      ],
      "title": "PredicateOperator",
      "type": "string"
    },
    "PromptWriterOutput": {
      "additionalProperties": false,
      "properties": {
        "expected_public_effect": {
          "title": "Expected Public Effect",
          "type": "string"
        },
        "rationale_summary": {
          "title": "Rationale Summary",
          "type": "string"
        },
        "source_stage_id": {
          "title": "Source Stage Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "abstain",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "victim_message": {
          "title": "Victim Message",
          "type": "string"
        }
      },
      "required": [
        "status",
        "victim_message",
        "expected_public_effect",
        "source_stage_id",
        "rationale_summary"
      ],
      "title": "PromptWriterOutput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attack_graph": {
      "$ref": "#/$defs/AttackGraph"
    },
    "budget": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Budget",
      "type": "object"
    },
    "clean_baseline": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Clean Baseline",
      "type": "object"
    },
    "dataset_version": {
      "title": "Dataset Version",
      "type": "string"
    },
    "expected_predicates": {
      "items": {
        "$ref": "#/$defs/Predicate"
      },
      "title": "Expected Predicates",
      "type": "array"
    },
    "initial_snapshot_hash": {
      "title": "Initial Snapshot Hash",
      "type": "string"
    },
    "pair_id": {
      "title": "Pair Id",
      "type": "string"
    },
    "sample_hash": {
      "title": "Sample Hash",
      "type": "string"
    },
    "sample_id": {
      "title": "Sample Id",
      "type": "string"
    },
    "seed_task": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Seed Task",
      "type": "object"
    },
    "verification_transcript_ref": {
      "title": "Verification Transcript Ref",
      "type": "string"
    },
    "verified_call_params": {
      "additionalProperties": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "title": "Verified Call Params",
      "type": "object"
    },
    "verifier_config": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Verifier Config",
      "type": "object"
    },
    "version_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Version Hashes",
      "type": "object"
    },
    "victim_messages": {
      "items": {
        "$ref": "#/$defs/PromptWriterOutput"
      },
      "title": "Victim Messages",
      "type": "array"
    }
  },
  "required": [
    "sample_id",
    "pair_id",
    "seed_task",
    "clean_baseline",
    "attack_graph",
    "verified_call_params",
    "victim_messages",
    "expected_predicates",
    "verifier_config",
    "budget",
    "initial_snapshot_hash",
    "version_hashes",
    "verification_transcript_ref",
    "sample_hash",
    "dataset_version"
  ],
  "title": "OfflineSample",
  "type": "object"
}