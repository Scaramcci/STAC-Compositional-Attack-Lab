+def _safe_auth_profile_structure(raw: str):
+    """Retain provider/profile metadata without persisting credentials."""
+    try:
+        parsed = json.loads(raw) if raw else {}
+    except json.JSONDecodeError:
+        return {"available": bool(raw), "parse_error": True}
+
+    profiles = []
+    for name, profile in parsed.get("profiles", {}).items():
+        if not isinstance(profile, dict):
+            continue
+        profiles.append({
+            "profile_name": name,
+            "provider": profile.get("provider"),
+            "credential_type": profile.get("type"),
+            "credential": "***REDACTED***",
+        })
+    return {"available": bool(raw), "profiles": profiles}
 
 
